# URL base del backend SIN /api/v1 (el panel lo agrega).
# Render (demo desplegada, datos sintéticos; se duerme sin uso):
VITE_API_URL=https://astro-health-api-81jd.onrender.com
# Backend local:  VITE_API_URL=http://localhost:3000
# Mock (Prism):   VITE_API_URL=http://localhost:4010

# Modo de datos:
#   api  (por defecto) → el panel llama al backend de VITE_API_URL.
#   mock → modo demo sin servidor: no sale a la red; responde src/api/mock/ con datos sintéticos
#          y las mismas rutas, esquemas y errores del contrato (VITE_API_URL no hace falta).
VITE_DATA_MODE=api

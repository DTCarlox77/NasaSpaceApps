{
  "name": "astro-health-panel",
  "private": true,
  "version": "0.1.0",
  "description": "Panel web del equipo en Tierra (control de misión, flight surgeon y salud conductual). Datos sintéticos.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",

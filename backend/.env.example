NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astro_health
DB_USER=astro
DB_PASSWORD=astro_dev
# Despliegue (Render/Railway): DATABASE_URL reemplaza a las DB_* de arriba.
# DATABASE_URL=postgres://usuario:clave@host:5432/base
# SSL de PostgreSQL: false (local) | no-verify (por defecto con DATABASE_URL) | true.
# DB_SSL=false
# CORS: "*" o varias URLs separadas por coma, p. ej. https://panel.example.com,http://localhost:5173
CORS_ORIGIN=*
# Saltos de proxy (Render/Railway = 1). Por defecto 1 con NODE_ENV=production y false fuera.
# TRUST_PROXY=1
# Seed de demo (datos SINTÉTICOS) en producción: solo con DEMO_SEED=true.
# DEMO_SEED=false
# Simulador de demo (POST /admin/simulator/*): sin true las rutas responden 404.
# En local, el CLI (npm run sim:history / sim:scenario) funciona sin esta variable.
SIMULATOR_ENABLED=false

# Autenticación
# JWT_SECRET es obligatorio fuera de development/test (mínimo 32 caracteres).
# En development/test, si se deja vacío se usa un secreto de desarrollo.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
TEMP_PASSWORD_LENGTH=12
RATE_LIMIT_LOGIN_PER_MINUTE=30

# Pruebas: base separada (node --test nunca toca DB_NAME). Se crea si el usuario tiene permiso.
DB_NAME_TEST=astro_health_test

# Semáforo: prescripción semanal de ejercicio (EXERCISE_MIN), en minutos.
EXERCISE_WEEKLY_PRESCRIPTION_MIN=600

# =====================================================================
# Astro Health API: variables de entorno (copia este archivo a .env).
# Los valores de abajo sirven para desarrollo local. Las comentadas (#) usan su valor por
# defecto, que es el que aparece. En Render se configuran en Environment (ver README).
# .env NUNCA se sube al repo.
# =====================================================================

# development | test | production. Fuera de development/test el servidor NO arranca sin un
# JWT_SECRET fuerte ni con CORS_ORIGIN=* (ver abajo).
NODE_ENV=development
# Puerto HTTP (Render lo pone solo).
PORT=3000

# ---------- Base de datos ----------
# Local (PostgreSQL o docker compose). Obligatorias si no hay DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astro_health
DB_USER=astro
DB_PASSWORD=astro_dev
# Despliegue (Render/Railway): DATABASE_URL reemplaza a las DB_* de arriba.
# DATABASE_URL=postgres://usuario:clave@host:5432/base
# SSL de PostgreSQL: false (por defecto con DB_*) | no-verify (por defecto con DATABASE_URL) | true.
# DB_SSL=false
# Pruebas: base separada (node --test nunca toca DB_NAME). Se crea si el usuario tiene permiso.
DB_NAME_TEST=astro_health_test

# ---------- HTTP ----------
# Orígenes del navegador que pueden llamar a la API (panel y Expo web), separados por coma,
# como esquema://host[:puerto] sin ruta. "*" solo en development/test: con NODE_ENV=production
# el servidor no arranca con "*" ni vacío. Las apps nativas no mandan Origin: no lo necesitan.
# Ej.: CORS_ORIGIN=https://panel.example.com,http://localhost:5173,http://localhost:8081
CORS_ORIGIN=*
# Saltos de proxy delante de la API (Render/Railway/ngrok = 1): el rate limit y la auditoría
# ven la IP real. Por defecto 1 con NODE_ENV=production y false fuera.
# TRUST_PROXY=false

# ---------- Demo (datos SINTÉTICOS) ----------
# Seed de demo en producción (usuarios con Demo2026!): solo con DEMO_SEED=true.
# DEMO_SEED=false
# Simulador (POST /admin/simulator/*) y reinicio de demo (POST /admin/demo/reset): sin true
# responden 404. El reinicio además exige DEMO_SEED=true fuera de development/test.
# En local, los CLI (npm run sim:* y demo:reset) funcionan sin esta variable.
SIMULATOR_ENABLED=false

# ---------- Autenticación ----------
# Fuera de development/test: obligatorio, >= 32 caracteres, aleatorio (no "changeme",
# "secret", el de desarrollo, etc.). En development/test, vacío = secreto de desarrollo.
# Genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Vida del access token y del refresh token (s, m, h o d).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Intentos fallidos antes de bloquear la cuenta y minutos de bloqueo (423).
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Largo de la contraseña temporal de altas y resets (mínimo 10).
TEMP_PASSWORD_LENGTH=12
# Logins por IP y minuto; más → 429 (en memoria: una sola instancia).
RATE_LIMIT_LOGIN_PER_MINUTE=30
# Credenciales de tableta inválidas (X-Device-Credential) por IP y minuto; más → 429.
RATE_LIMIT_DEVICE_CREDENTIAL_PER_MINUTE=10
# PIN offline: días de desbloqueo sin conexión desde el último login en línea.
OFFLINE_UNLOCK_DAYS=7
# PIN offline: iteraciones de PBKDF2-HMAC-SHA256 del verificador local de la app (las recibe
# en offline_verifier). 600000 = OWASP; bájalo (mínimo 10000) solo si la app tarda demasiado.
OFFLINE_PIN_PBKDF2_ITERATIONS=600000

# ---------- Semáforo ----------
# Prescripción semanal de ejercicio (EXERCISE_MIN), en minutos.
EXERCISE_WEEKLY_PRESCRIPTION_MIN=600

# ---------- Sincronización offline (POST /sync/push, GET /sync/pull) ----------
# Máximo de items por lote (más → 413).
SYNC_MAX_BATCH=500
# measured_at más de esto en el futuro (s) → rejected FUTURE_TIMESTAMP (también en línea).
SYNC_MAX_FUTURE_SKEW_S=300
# Lectura registrada más de esto (s) después de medirse → late_sync en el resultado y el panel.
SYNC_LATE_AFTER_S=900
# El pull solo devuelve cambios con más de esta antigüedad (ms), para que el cursor no salte filas.
SYNC_PULL_SETTLE_MS=2000

# ---------- Triaje (modo emergencia) ----------
# El botón manual siempre funciona; esto controla lo automático.
TRIAGE_AUTO_ENABLED=true
# Lectura crítica (de los indicadores que indica el protocolo) abre la emergencia.
TRIAGE_AUTO_CRITICAL_READING=true
# Una lectura crítica medida hace más de esto (min) escala, pero no abre la emergencia.
TRIAGE_AUTO_READING_MAX_AGE_MIN=120
# Check-in perdido: horas sin check-in. Cuenta solo desde la última carga de la historia
# del simulador (o el reinicio de demo) o desde TRIAGE_AUTO_SINCE (ISO 8601); sin ninguna,
# no se detecta.
TRIAGE_AUTO_MISSED_CHECKIN=true
TRIAGE_AUTO_MISSED_CHECKIN_H=30
# TRIAGE_AUTO_SINCE=2026-11-15T00:00:00Z
# Hombre muerto: segundos para que el tripulante afectado responda "estoy bien".
TRIAGE_DEADMAN_S=60
# Cada cuánto barre el servidor los plazos vencidos (0 = solo al leer la sesión).
TRIAGE_SWEEP_INTERVAL_S=15

# ---------- Bienestar (reglas de diseño, no umbrales clínicos) ----------
# Un solo escalamiento conductual abierto por astronauta e indicador hasta que
# behavioral_health lo cierre (false = escala cada check-in que siga sostenido).
WELLBEING_ONE_OPEN_ESCALATION=true
# Aptitud para tarea crítica: PVT de las últimas N horas; sin PVT reciente → not_confirmed.
WELLBEING_FITNESS_MAX_AGE_H=12
# PHQ-2 y GAD-2 cada N días (screening_due un día antes de la conferencia psicológica).
WELLBEING_SCREENING_EVERY_DAYS=14

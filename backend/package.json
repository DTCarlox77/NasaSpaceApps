{
  "name": "astro-health-backend",
  "version": "0.1.0",
  "description": "API de apoyo a la decisión para el monitoreo de salud de astronautas (datos sintéticos)",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:deploy": "node scripts/start.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "sim:history": "node scripts/simulate.js history",
    "sim:scenario": "node scripts/simulate.js scenario",
    "lint": "eslint .",
    "format": "prettier --write .",
    "api:lint": "npx --yes @redocly/cli@2.72.1 lint docs/openapi.yaml",
    "api:mock": "npx --yes @stoplight/prism-cli@5.16.0 mock docs/openapi.yaml -p 4010"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.1"
  }
}

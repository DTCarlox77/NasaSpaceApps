# Copia este archivo como `.env` y ajusta los valores. Nunca subas tu `.env` al repositorio.

# Host de la API SIN /api/v1. Vacío = modo demo sin servidor (maqueta y datos solo en el dispositivo).
# API desplegada (datos sintéticos compartidos):
#   EXPO_PUBLIC_API_URL=https://astro-health-api-81jd.onrender.com
# API local: usa la IP de tu PC en la red (no "localhost"): el teléfono es otro dispositivo.
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=https://astro-health-api-81jd.onrender.com

# Timeout normal de cada petición (ms).
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Timeout de GET /api/v1/health al abrir la app (ms). Render gratuito se duerme y tarda ~50 s en despertar.
EXPO_PUBLIC_API_WAKE_TIMEOUT_MS=60000

# "true" = pedir login (usuario + contraseña / biometría). Con API el login es obligatorio siempre.
# Sin API: cualquier otro valor o vacío = entrar directo con una sesión demo y datos de maqueta.
EXPO_PUBLIC_REQUIRE_AUTH=true
# local (por defecto) = Monitor/Medir/Registro con simulación de equipos y guardado en el dispositivo · server = /me/body-status y POST /readings
EXPO_PUBLIC_HEALTH_MODE=local

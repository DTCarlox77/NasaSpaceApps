# Copia este archivo como `.env` y ajusta los valores.
# Usa la IP de tu PC en la red (no "localhost"): el teléfono es otro dispositivo.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_TIMEOUT_MS=8000

# "true" = pedir login (ID de astronauta + contraseña / biometría).
# Cualquier otro valor o vacío = entrar directo con una sesión demo y datos de maqueta.
EXPO_PUBLIC_REQUIRE_AUTH=false

# Finales de línea: LF en el repo y en la copia de trabajo, en todos los sistemas
# (Prettier usa endOfLine: lf). Ignora core.autocrlf de cada máquina.
* text=auto eol=lf

# Binarios: sin conversión ni diff de texto.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
